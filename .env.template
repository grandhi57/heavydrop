# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID. Message @userinfobot on Telegram to get it.
TELEGRAM_CHAT_ID=your_chat_id_here

# Residential Proxy (optional — leave blank to scrape without proxy)
# Format: http://user:pass@host:port
RESIDENTIAL_PROXY_URL=

# How often to auto-check prices (in minutes). Default: 30
CHECK_INTERVAL_MINUTES=30
